@startuml
skinparam actorStyle awesome
left to right direction

actor "Fleet Manager" as FM
actor "Simulation Engine" as SE

rectangle "Vehicle and Fuel Telemetry Module" {
   
    ' 1. Vehicle Management
    package "Vehicle Management" {
        FM --> (Register Vehicle)
        FM --> (Update Vehicle Details)
        FM --> (View Vehicle Details)
        FM --> (Assign Vehicle to Fleet)
        FM --> (Remove Vehicle from Fleet)
        FM --> (Assign Fuel Sensor on Vehicle)
    }

    ' 2. Fleet Management
    package "Fleet Management" {
        FM --> (Create Fleet)
        FM --> (Update Fleet Name)
    }

    ' Fleet Manager
    package "Fleet Manager" {
        FM --> (Create Manager)
    }

    ' 3. Core Simulation & Telemetry (Serves the System's Main Goal)
    package "Real-Time Telemetry Simulation" {
        SE --> (Generate Simulated Fuel Reading)
        FM --> (View Fleet Fuel Efficiency Dashboard)
        (Generate Simulated Fuel Reading) ..> (Trigger Fuel Theft Alert) : <<extend>> if level drops sharply
    }
}
@enduml
