@startuml
skinparam handwritten false
skinparam titleFontSize 18
title FleetFuel Authentication Module - Domain Layer

Package AuthenticationManagement {
   Package Domain {
      Package Entities {
         Package "User Aggregate" <<Rectangle>> {
            Class User <<AggregateRoot>> {
               - id: string
               - email: string
               - passwordHash: string
               - role: USER_ROLES
               - affiliatedServiceId: string
               - createdAt: DateTime
               - updatedAt: DateTime
               ---
               + {static} constructor({id, email, passwordHash, role, affiliatedServiceId, createdAt, updatedAt}): User
               + toJSON(): Object
            }
         }
      }

      Package Enums {
         Enum USER_ROLES {
            FUEL_SUPPLIER
            FLEET_COMPANY
         }
      }

      Package ValueObjects {
         Class Session {
            - token: string
            - userId: string
            - createdAt: DateTime
         }
      }

      Package Exceptions {
         Class AuthenticationError
         Class ConflictError
         Class ValidationError
      }

      Package Repositories {
         Interface UserRepository {
            + save(user: User): User
            + findByEmail(email: string): User | null
            + findById(id: string): User | null
         }

         Interface SessionRepository {
            + save(session: Session): Session
            + findByToken(token: string): Session | null
            + deleteByToken(token: string): boolean
         }
      }

      USER_ROLES --o User : has <
      Session ..> User : references >
   }
}
@enduml
